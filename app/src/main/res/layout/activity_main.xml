<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvWelcomeEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_eyebrow"
        android:textColor="@color/color_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="28dp" />

    <TextView
        android:id="@+id/tvWelcomeTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/welcome_title"
        android:textColor="@color/color_text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="sans"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeEyebrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvWelcomeDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/welcome_description"
        android:textColor="@color/color_text_secondary"
        android:textSize="16sp"
        android:lineSpacingExtra="5dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWelcomeIllustration"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="1dp"
        app:strokeColor="@color/color_border"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/welcome_illustration_description"
                android:text="Aa"
                android:textColor="@color/color_primary"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_description"
                android:textColor="@color/color_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutWelcomeActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/tvWelcomeFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcomeLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/welcome_button_login"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/color_primary"
            android:textColor="@color/color_on_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWelcomeRegister"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/welcome_button_register"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/color_primary"
            app:cornerRadius="16dp"
            app:strokeColor="@color/color_border" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvWelcomeFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        android:text="@string/welcome_footer"
        android:textColor="@color/color_text_secondary"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>